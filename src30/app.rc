// ImageWalker by Zac Walker
// Defines icons, bitmaps, cursors, and accelerators used by the ImageWalker 3.0 application.

#include <windows.h>
#include "Resource.h"

IDI_APP ICON "Res\\ImageWalker.ico"
IDC_ZOOM_CURSOR CURSOR "Res\\zoom.cur"
IDB_TOOLBAR_SYMBOLS BITMAP "Res\\ToolbarSymbols.bmp"
IDB_FILE_FOLDER BITMAP "Res\\FileTypes\\folder.bmp"
IDB_FILE_PHOTO BITMAP "Res\\FileTypes\\photo.bmp"
IDB_FILE_DOCUMENT BITMAP "Res\\FileTypes\\document.bmp"
IDB_FILE_VIDEO BITMAP "Res\\FileTypes\\video.bmp"
IDB_FILE_AUDIO BITMAP "Res\\FileTypes\\audio.bmp"
IDB_FILE_OTHER BITMAP "Res\\FileTypes\\other.bmp"
IDB_STATUS_SYMBOLS BITMAP "Res\\FileTypes\\status-symbols.bmp"

// The compiled help, written out before it is shown; see include/core/help_file.h.
// CMake defines IW_EMBED_HELP when it has built ImageWalker.chm.
#ifdef IW_EMBED_HELP
IMAGEWALKER_HELP RCDATA "ImageWalker.chm"
#endif
