{
    // build/ is 26k files / 4.8GB (three trees, each with its own _deps copy of the
    // FetchContent libraries) and exe/ holds ~95MB PDBs rewritten by every build.
    // Watching or indexing them makes each build storm the extension host.
    "files.watcherExclude": {
        "**/build/**": true,
        "**/exe/**": true,
        "**/.vs/**": true
    },
    "search.exclude": {
        "build": true,
        "exe": true,
        ".vs": true
    },
    // Without a provider cpptools recursively tag-parses the whole folder, which
    // means three near-identical copies of every third-party header in build/*/_deps.
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "C_Cpp.files.exclude": {
        "**/build/**": true,
        "**/exe/**": true,
        "**/.vs/**": true
    },
    "C_Cpp.default.browse.path": [
        "${workspaceFolder}/src10",
        "${workspaceFolder}/src20",
        "${workspaceFolder}/src22",
        "${workspaceFolder}/src23",
        "${workspaceFolder}/src30",
        "${workspaceFolder}/include"
    ],
    "C_Cpp.default.cppStandard": "c++20",
    "C_Cpp.default.cStandard": "c17",
    "chat.tools.terminal.autoApprove": {
        ".\\dd.ps1": true
    }
}
