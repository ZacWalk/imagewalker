add_library(applib STATIC src/applib.c)
target_include_directories(applib PUBLIC include)
add_executable(app src/main.c)
target_link_libraries(app PRIVATE applib)
include(CTest)
if(BUILD_TESTING)
    add_executable(applib_tests tests/lib_tests.c)
    target_link_libraries(applib_tests PRIVATE applib)
    add_test(NAME lib_unit COMMAND applib_tests)
    set_tests_properties(lib_unit PROPERTIES TIMEOUT 30 LABELS lib)
    add_test(NAME app_help COMMAND app --help)
    set_tests_properties(app_help PROPERTIES PASS_REGULAR_EXPRESSION "Usage:" TIMEOUT 30 LABELS app)
endif()
