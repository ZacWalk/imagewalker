IDR_PREVIEW_SAMPLE      IMAGE                   "Res\\preview_sample.jpg"

/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

// Nothing that writes to a file is on an unmodified key: the items pane is a
// place people type file names, and S, L and R used to overwrite the selection.
// No unmodified LETTER at all, for the same reason -- the frame translates
// accelerators before the pane sees the key, so any letter here is one the
// user can no longer type to jump to a file.
IDR_MAINFRAME ACCELERATORS 
BEGIN
    "A",            ID_EDIT_SELECT_ALL,     VIRTKEY, CONTROL, NOINVERT
    "C",            ID_EDIT_COPY,           VIRTKEY, CONTROL, NOINVERT
    "C",            ID_IMAGE_COPY,          VIRTKEY, SHIFT, CONTROL, NOINVERT
    "D",            ID_EDIT_INVERTSELECTION, VIRTKEY, CONTROL, NOINVERT
    "D",            ID_VIEW_DESCRIPTION,    VIRTKEY, SHIFT, CONTROL, NOINVERT
    "F",            ID_VIEW_FOLDERS,        VIRTKEY, SHIFT, CONTROL, NOINVERT
    "I",            ID_EDIT_SELECTALLIMAGES, VIRTKEY, CONTROL, NOINVERT
    "L",            ID_EDIT_ROTATELEFT,     VIRTKEY, CONTROL, NOINVERT
    "K",            ID_EDIT_CROP,           VIRTKEY, CONTROL, NOINVERT
    "B",            ID_EDIT_COMPARE,        VIRTKEY, CONTROL, NOINVERT
    "N",            ID_BROWSE_NEWFOLDER,    VIRTKEY, CONTROL, NOINVERT
    "N",            ID_VIEW_NORMAL,         VIRTKEY, SHIFT, CONTROL, NOINVERT
    "E",            ID_VIEW_EDIT,           VIRTKEY, SHIFT, CONTROL, NOINVERT
    "O",            ID_FILE_OPEN,           VIRTKEY, CONTROL, NOINVERT
    "P",            ID_FILE_PRINT,          VIRTKEY, CONTROL, NOINVERT
    "P",            ID_VIEW_PRINT,          VIRTKEY, SHIFT, CONTROL, NOINVERT
    "R",            ID_EDIT_ROTATERIGHT,    VIRTKEY, CONTROL, NOINVERT
    "S",            ID_EDIT_SAVE,           VIRTKEY, CONTROL, NOINVERT
    "S",            ID_EDIT_SAVEAS,         VIRTKEY, SHIFT, CONTROL, NOINVERT
    "V",            ID_EDIT_PASTE,          VIRTKEY, CONTROL, NOINVERT
    VK_DELETE,      ID_EDIT_DELETE,         VIRTKEY, NOINVERT
    VK_DELETE,      ID_EDIT_CUT,            VIRTKEY, SHIFT, NOINVERT
    VK_F1,          ID_HELP_FINDER,         VIRTKEY, NOINVERT
    VK_F10,         ID_VIEW_PRINT,          VIRTKEY, NOINVERT
    VK_F11,         ID_VIEW_IMAGEFULLSCREEN, VIRTKEY, NOINVERT
    VK_F12,         ID_VIEW_EDIT,           VIRTKEY, NOINVERT
    VK_F2,          ID_BROWSE_RENAME,       VIRTKEY, NOINVERT
    VK_F3,          ID_VIEW_SEARCHADVANCED, VIRTKEY, NOINVERT
    VK_F4,          ID_VIEW_NORMAL,         VIRTKEY, NOINVERT
    VK_F5,          ID_VIEW_REFRESHX,       VIRTKEY, NOINVERT
    VK_F6,          ID_TOOLS_OPTIONS,       VIRTKEY, NOINVERT
    VK_F7,          ID_FILE_MOVETO_POPUP,   VIRTKEY, NOINVERT
    VK_F8,          ID_FILE_COPYTO_POPUP,   VIRTKEY, NOINVERT
    VK_F9,          ID_VIEW_FOLDERS,        VIRTKEY, NOINVERT
    VK_INSERT,      ID_EDIT_COPY,           VIRTKEY, CONTROL, NOINVERT
    VK_INSERT,      ID_EDIT_PASTE,          VIRTKEY, SHIFT, NOINVERT
    VK_LEFT,        ID_BROWSE_BACK,         VIRTKEY, ALT, NOINVERT
    VK_RETURN,      ID_FILE_PROPERTIES,     VIRTKEY, ALT, NOINVERT
    VK_RIGHT,       ID_BROWSE_FORWARD,      VIRTKEY, ALT, NOINVERT
    VK_SPACE,       ID_IMAGE_NEXT,          VIRTKEY, NOINVERT
    VK_UP,          ID_BROWSE_PARENT,       VIRTKEY, ALT, NOINVERT
    "X",            ID_EDIT_CUT,            VIRTKEY, CONTROL, NOINVERT
    "Z",            ID_EDIT_UNDO_IMAGE,     VIRTKEY, CONTROL, NOINVERT
END


