IDR_MAINFRAME MENU 
BEGIN
    POPUP "File"
    BEGIN
        POPUP "Open"
        BEGIN
            MENUITEM "Open...",                     ID_FILE_OPEN
            MENUITEM "Open With...",                ID_FILE_OPEN_WITH
            MENUITEM "Open containing folder",      ID_FILE_OPENCONTAINING
            MENUITEM "Open in Windows Explorer",    ID_FILE_EXPLORE
        END
        MENUITEM SEPARATOR
        MENUITEM "Save",                        ID_EDIT_SAVE
        MENUITEM "Save and Move Next",          ID_EDIT_SAVE_MOVENEXT
        MENUITEM "Save As...",                  ID_EDIT_SAVEAS
        MENUITEM SEPARATOR
        MENUITEM "Browse Parent",               ID_BROWSE_PARENT
        MENUITEM "Previous Folder",             ID_BROWSE_BACK
        MENUITEM "Next Folder",                 ID_BROWSE_FORWARD
        MENUITEM SEPARATOR
        MENUITEM "Move To",                     ID_FILE_MOVETO_POPUP
        MENUITEM "Copy To",                     ID_FILE_COPYTO_POPUP
        MENUITEM SEPARATOR
        MENUITEM "New Folder",                  ID_BROWSE_NEWFOLDER
        MENUITEM "Rename",                      ID_BROWSE_RENAME
        MENUITEM "Properties...",               ID_FILE_PROPERTIES
        MENUITEM SEPARATOR
        POPUP "Search"
        BEGIN
            MENUITEM "Search Current Folder",       ID_SEARCH_CURRENT
            MENUITEM "Search My Pictures",          ID_SEARCH_MYPICTURES
            MENUITEM "Search Clear",                ID_SEARCH_STOP
            MENUITEM "Images in sub folders",       ID_SEARCH_IMAGESINSUBFOLDERS
        END
        MENUITEM SEPARATOR
        MENUITEM "Exit",                        ID_APP_EXIT
    END
    POPUP "Edit"
    BEGIN
        MENUITEM "Undo Image Edit",             ID_EDIT_UNDO_IMAGE
        MENUITEM SEPARATOR
        MENUITEM "Cut",                         ID_EDIT_CUT
        MENUITEM "Copy",                        ID_EDIT_COPY
        MENUITEM "Copy File Paths",             ID_EDIT_COPY_PATHS
        MENUITEM "Paste",                       ID_EDIT_PASTE
        MENUITEM SEPARATOR
        POPUP "Select"
        BEGIN
            MENUITEM "Select All",                  ID_EDIT_SELECT_ALL
            MENUITEM "Invert Selection",            ID_EDIT_INVERTSELECTION
            MENUITEM "Select All Images",           ID_EDIT_SELECTALLIMAGES
        END
        MENUITEM SEPARATOR
        MENUITEM "Delete",                      ID_EDIT_DELETE
    END
    POPUP "View"
    BEGIN
        MENUITEM "Normal",                      ID_VIEW_NORMAL
        MENUITEM "Folders",                     ID_VIEW_FOLDERS
        MENUITEM "Search",                      ID_VIEW_SEARCHADVANCED
        MENUITEM "Edit",                        ID_VIEW_EDIT
        MENUITEM "Print",                       ID_VIEW_PRINT
        MENUITEM SEPARATOR
        MENUITEM "Full Screen",                 ID_VIEW_IMAGEFULLSCREEN
        MENUITEM SEPARATOR
        POPUP "Thumbnails"
        BEGIN
            MENUITEM "Thumbnail",                   ID_THUMBNAILS_THUMBNAIL
            MENUITEM "Detail",                      ID_THUMBNAILS_DETAIL
            MENUITEM "Matrix",                      ID_THUMBNAILS_MATRIX
        END
        POPUP "Arrange Icons"
        BEGIN
            MENUITEM "Name",                        ID_ARRANGEICONS_NAME
            MENUITEM "Size",                        ID_ARRANGEICONS_SIZE
            MENUITEM "Type",                        ID_ARRANGEICONS_TYPE
            MENUITEM "Modified",                    ID_ARRANGEICONS_MODIFIED
            MENUITEM "Date Taken",                  ID_ARRANGEICONS_DATETAKEN
            MENUITEM "More...",                     ID_ARRANGEICONS_MORE
        END
        MENUITEM SEPARATOR
        POPUP "Show"
        BEGIN
            MENUITEM "Description Panel",           ID_VIEW_DESCRIPTION
            MENUITEM "More Image Details",          ID_VIEW_ADVANCEDIMAGE
            MENUITEM "Fewer Image Details",         ID_VIEW_LESSIMAGE
        END
        MENUITEM SEPARATOR
        MENUITEM "Refresh",                     ID_VIEW_REFRESHX
    END
    POPUP "Image"
    BEGIN
        MENUITEM "Previous Image",              ID_IMAGE_PREVIOUS
        MENUITEM "Next Image",                  ID_IMAGE_NEXT
        MENUITEM SEPARATOR
        POPUP "Scale"
        BEGIN
            MENUITEM "Scale to Fit",                ID_SCALE_FIT
            MENUITEM "Scale to Fill",               ID_SCALE_FILL
            MENUITEM "Scale image Up",              ID_SCALE_UP
            MENUITEM "Scale down",                  ID_SCALE_DOWN
            MENUITEM "Scale to actual size (100%)", ID_SCALE_100
            MENUITEM "Scale to half size",          ID_SCALE_50
            MENUITEM "Scale to double",             ID_SCALE_200
            MENUITEM "Toggle Scale",                ID_SCALE_TOGGLE
        END
        MENUITEM SEPARATOR
        MENUITEM "Edit",                        ID_VIEW_EDIT
        MENUITEM "Reset Crop",                  ID_EDIT_CROP
        MENUITEM "Rotate Left",                 ID_EDIT_ROTATELEFT
        MENUITEM "Rotate Right",                ID_EDIT_ROTATERIGHT
        MENUITEM "Compare Before and After",    ID_EDIT_COMPARE
        MENUITEM "Discard Changes",             ID_EDIT_CANCEL_EDITS
        MENUITEM SEPARATOR
        MENUITEM "Copy Image",                  ID_IMAGE_COPY
    END
    POPUP "Print"
    BEGIN
        MENUITEM "Print",                       ID_VIEW_PRINT
        MENUITEM SEPARATOR
        MENUITEM "Print...",                    ID_FILE_PRINT
        MENUITEM "Page Setup...",               ID_FILE_PAGE_SETUP
        MENUITEM "Save Contact Sheet",          ID_FILE_PRINTING_SAVECONTACTSHEET
        MENUITEM SEPARATOR
        MENUITEM "Previous Print Page",         ID_PP_BACK
        MENUITEM "Next Print Page",             ID_PP_FORWARD
    END
    POPUP "Tools"
    BEGIN
        MENUITEM "Convert Images",              ID_TOOLS_CONVERTIMAGES
        MENUITEM "Loss-Less Jpeg",              ID_TOOLS_LOSSLESS
        MENUITEM "Resize Images",               ID_TOOLS_RESIZE
        MENUITEM SEPARATOR
        MENUITEM "Options",                     ID_TOOLS_OPTIONS
    END
    POPUP "Help"
    BEGIN
        MENUITEM "Help Topics",                 ID_HELP_FINDER
        MENUITEM "ImageWalker Home Page...",    ID_HELP_IMAGEWALKERHOMEPAGE
        MENUITEM SEPARATOR
        MENUITEM "About ImageWalker...",        57664
    END
END

